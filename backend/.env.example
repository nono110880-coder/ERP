# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL / MariaDB / XAMPP phpMyAdmin)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=form_batch_erp

# Database Connection Pool Tuning
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000
DB_TIMEZONE=+07:00
DB_CHARSET=utf8mb4

# CORS Configuration (Dipisahkan koma atau '*' untuk mengizinkan semua origin)
CLIENT_ORIGIN=http://localhost:5173
